{
  "name": "admitra",
  "private": true,
  "description": "AdMitra AI — AI ad studio (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "worker": "npm run dev -w apps/media-worker",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts",
    "db:push:staging": "supabase db push --remote",
    "dev:staging": "npm run dev:staging -w apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "supabase": "^3.3.0"
  }
}
