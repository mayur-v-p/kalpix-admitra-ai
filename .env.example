# Copy to apps/web/.env.local for local development. Names only — never commit real values.

# --- Browser-safe (VITE_ prefix is bundled into the website) ---
# Only the Supabase URL and the PUBLISHABLE (anon) key may ever use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets: set as Supabase Edge Function secrets / worker env, NEVER with VITE_ ---
# SUPABASE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# LLM_API_KEY=
# BG_REMOVAL_API_KEY=
# AI_VIDEO_API_KEY=
# AI_VIDEO_WEBHOOK_SECRET=
# SMS_PROVIDER_API_KEY=
