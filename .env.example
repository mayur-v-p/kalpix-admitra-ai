# Copy to apps/web/.env.local for local development. Names only — never commit real values.

# --- Browser-safe (VITE_ prefix is bundled into the website) ---
# Only the Supabase URL and the PUBLISHABLE (anon) key may ever use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional, public: Cloudflare Turnstile site key (captcha) and Sentry DSN (error monitoring).
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=

# --- Server-only secrets: set as Supabase Edge Function secrets / worker env, NEVER with VITE_ ---
# SUPABASE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# TURNSTILE_SECRET_KEY=       (Supabase Auth captcha secret; on hosted projects set it in Auth > Attack Protection)
# RAZORPAY_ACCOUNT_ID=        (optional: refuse webhooks for any other Razorpay account)
# OPENAI_API_KEY=             (AI understanding of "Speak your ad" + AI ad text; optional)
# OPENAI_MODEL=               (optional, default gpt-5-mini)
# COPY_PROVIDER=              (optional: mock | openai; default openai when OPENAI_API_KEY is set)
# BG_REMOVAL_API_KEY=
# AI_VIDEO_API_KEY=
# AI_VIDEO_WEBHOOK_SECRET=
# SMS_PROVIDER_API_KEY=
