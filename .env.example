# Kalpix: every environment variable, with placeholder values. NEVER commit real values.
#
# You do NOT need this file to run Kalpix: `docker compose up` starts the app and shows its main
# screen with no .env file and no keys (the website then uses the public Kalpix staging
# backend). Features that need a server key show a message or fall back to a no-AI version.

# --- 1. Website (Docker build args / apps/web/.env.local) ---------------------------------------
# Browser-safe values only. Leave them EMPTY to use the built-in staging defaults from
# docker-compose.yml; set them to point the website at your own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional, public: Cloudflare Turnstile site key (captcha), Sentry DSN, release name.
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_RELEASE=

# --- 2. Server: Supabase Edge Function secrets (supabase/.env locally, Supabase secrets hosted) -
# Never give these a VITE_ prefix: they must never reach the browser.
# Browser origins allowed to call the functions (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# AI (optional). Without a key: Kalpix's own speech parser, rule-based designs, sample ad text,
# the owner's photo as it is, no AI pictures.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
COPY_PROVIDER=openai
IMAGE_ENHANCE_PROVIDER=openai
# Payments (Razorpay TEST keys for development).
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_ACCOUNT_ID=your-razorpay-account-id
# AI video scenes (test mode by default) and its webhook signature.
AI_VIDEO_PROVIDER=mock
AI_VIDEO_WEBHOOK_SECRET=your-random-64-char-secret
# Retired background removal (kept for old products): mock by default.
BG_REMOVAL_PROVIDER=mock
# Captcha secret (hosted projects: Supabase Auth > Attack Protection).
TURNSTILE_SECRET_KEY=your-turnstile-secret

# --- 3. Media worker (apps/media-worker/.env): renders the MP4 videos ---------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=your-supabase-secret-key
QR_BASE_URL=https://your-project-ref.supabase.co/functions/v1/qr-redirect
WORKER_ID=worker-1
WORK_DIR=/tmp/kalpix-renders
RENDER_CONCURRENCY=1
POLL_INTERVAL_MS=3000
LEASE_SECONDS=900
BROWSER_EXECUTABLE=
REMOTION_LICENSE_KEY=
